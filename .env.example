APP_NAME=Qanoni | قانوني
APP_VERSION=4.0.0-rc
APP_ENV=v4-release-candidate
HOST=127.0.0.1
PORT=8000
SQLITE_PATH=data/qanoni.sqlite3

# Optional answer-generation provider. Server-side only. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional cognition-only LLM. Qanoni works without this key and falls back automatically.
# Create a free Groq key in the Groq console and keep the real value only in .env / Railway Variables.
COGNITION_LLM_ENABLED=true
COGNITION_LLM_PROVIDER=auto
COGNITION_LLM_TIMEOUT_SECONDS=12
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_COGNITION_MODEL=openai/gpt-oss-120b

# Supabase: server-side only. Use Project URL + service-role/secret key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# auto = Supabase for conversations/feedback when configured, otherwise SQLite.
RUNTIME_STORE=auto

# Optional. Set this before exposing /api/admin/sync on a public deployment.
# If blank, admin sync is disabled.
ADMIN_API_KEY=

SYNC_TIMEOUT_SECONDS=35
SYNC_MAX_DOCS_PER_SOURCE=100
SYNC_USER_AGENT=QanoniV4/4.0 (+Jordan legal research pilot)
