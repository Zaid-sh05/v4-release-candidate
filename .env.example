APP_NAME=Qanoni | قانوني
APP_VERSION=3.6.0-pilot-final
APP_ENV=pilot-final
HOST=127.0.0.1
PORT=8000ccc
SQLITE_PATH=data/qanoni.sqlite3

# OpenAI: server-side only. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase: server-side only. Use Project URL + service-role/secret key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# auto = Supabase for conversations/feedback when configured, otherwise SQLite.
RUNTIME_STORE=auto

# Optional. Set this before exposing /api/admin/sync on a public deployment.
# If blank, admin sync is disabled.
ADMIN_API_KEY=

SYNC_TIMEOUT_SECONDS=35
SYNC_MAX_DOCS_PER_SOURCE=100
SYNC_USER_AGENT=QanoniPilot/3.6 (+Jordan legal research pilot)
